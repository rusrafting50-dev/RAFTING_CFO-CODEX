# Секретный ключ Flask (сессии, flash-сообщения)
SECRET_KEY=change-me-to-a-random-secret

# Путь к общей базе данных. По умолчанию (переменная не задана) используется
# shared.db рядом с app.py — именно этот файл читают COREZ, REGTEAM_RAFTING
# и SPORTS_REFEREE, поэтому его расположение менять не рекомендуется.
# Относительный sqlite:///путь резолвится Flask-SQLAlchemy НЕ от каталога
# проекта, а от instance/ — если всё же переопределяете, указывайте
# абсолютный путь: sqlite:////полный/путь/до/shared.db
# DATABASE_URL=sqlite:////полный/путь/до/shared.db

# Ключ для доступа к API синхронизации (заголовок X-API-Key)
# Используется проектами COREZ, REGTEAM_RAFTING, SPORTS_REFEREE
API_KEY=change-me-to-a-random-api-key
